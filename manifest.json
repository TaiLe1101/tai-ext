{
  "manifest_version": 3,
  "name": "YouTube Realtime AI Voiceover",
  "version": "2.0.0",
  "minimum_chrome_version": "116",
  "description": "Lồng tiếng YouTube bằng TAI Desktop và AI worker, có cache trên máy.",
  "permissions": ["storage", "activeTab", "tabCapture", "offscreen"],
  "action": { "default_popup": "popup.html", "default_title": "TAI — Thu audio và dịch" },
  "host_permissions": ["https://www.youtube.com/*", "http://127.0.0.1:3000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ]
}
